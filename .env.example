# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# docker-compose.yml reads from .env automatically.
# ──────────────────────────────────────────────────────────────

# ── MySQL ──────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=game_db
MYSQL_USER=game_admin
MYSQL_PASSWORD=devpassword123

# ── JWT (must be at least 32 characters for HMAC-SHA256) ───────
JWT_SECRET=local-dev-jwt-secret-key-32bytes!!

# ── Default admin user seeded on first startup ─────────────────
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=Admin1234!
