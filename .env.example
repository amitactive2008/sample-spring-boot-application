# Copy only the variables you need into an untracked .env file.
# Never commit real passwords or signing keys.

SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRATIONMINUTES=60

SPRING_DATASOURCE_USERNAME=appuser
SPRING_DATASOURCE_PASSWORD=replace-me

APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=replace-me
MAIL_ENABLED=false

# Frontend: leave empty when the gateway and UI share an origin.
REACT_APP_API_BASE_URL=

