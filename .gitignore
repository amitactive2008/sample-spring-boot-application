# =============================================================================
# .gitignore — Issue Tracker v3 (Kind / Kubernetes)
# Covers: Maven, Spring Boot, React/Node, Docker, Kubernetes/Kind, IDEs, OS
# =============================================================================

# ── Secrets & environment ─────────────────────────────────────────────────────
# Keep .env.example (template); ignore real values
.env
.env.local
.env.*.local

# ── Maven build output ────────────────────────────────────────────────────────
**/target/

# Maven wrapper JAR (downloaded on first use; not needed in VCS)
.mvn/wrapper/maven-wrapper.jar

# ── Compiled Java ─────────────────────────────────────────────────────────────
*.class
*.jar
*.war
*.ear
*.nar

# ── Spring Boot ───────────────────────────────────────────────────────────────
# Local override files (never commit — they shadow application.properties)
application-local.properties
application-local.yml
**/src/main/resources/application-local.*
**/src/main/resources/application-dev.*

# Spring Boot log files
spring.log
*.log
logs/

# ── Node / React (root-level catch-all; frontend-service has its own) ─────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js

# React production build (never commit compiled output)
**/frontend-service/build/

# ── Docker ────────────────────────────────────────────────────────────────────
# Local override compose files
docker-compose.override.yml

# ── Kubernetes / Kind ─────────────────────────────────────────────────────────
# Local kubeconfig files — kind writes to ~/.kube/config by default,
# but developers sometimes export a cluster-specific file into the repo
kubeconfig
kubeconfig.yaml
kubeconfig.yml
*.kubeconfig

# Kustomize rendered output (generated by kubectl kustomize / kustomize build)
kustomize-output.yaml
kustomize-output.yml
all-in-one.yaml
rendered/

# Local environment patches (overrides meant for one workstation only)
# Keep base and kind overlays; ignore ad-hoc local tweaks
*-local.patch.yaml
*-override.yaml
kubernetes/environments/local/

# kind cluster debug logs (generated by: kind export logs)
kind-logs/

# Kubernetes dry-run / diff artifacts
*.diff.yaml
*.dry-run.yaml

# Sealed Secrets private keys (if Bitnami Sealed Secrets is ever used)
*.pem
sealed-secrets-key.yaml

# Temporary manifests generated during debugging
kubectl-debug-*
debug-pod.yaml

# ── Pipeline reports ──────────────────────────────────────────────────────────
pipeline-reports/
**/dependency-check-report.*
**/semgrep-*.json
**/zap-report.*

# ── IntelliJ IDEA ─────────────────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
out/

# ── VS Code ───────────────────────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json

# ── Eclipse / STS ─────────────────────────────────────────────────────────────
.classpath
.project
.settings/
.factorypath

# ── NetBeans ──────────────────────────────────────────────────────────────────
nbproject/
nbbuild/
dist/
nbdist/
.nb-gradle/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# ── Windows ───────────────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Linux ─────────────────────────────────────────────────────────────────────
*~

# ── Temporary files ───────────────────────────────────────────────────────────
*.tmp
*.temp
*.swp
*.swo
