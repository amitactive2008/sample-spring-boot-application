# =============================================================================
# .gitignore — Issue Tracker (root)
# Covers: Maven, Spring Boot, React/Node, Docker/Podman, IDEs, OS, secrets
# =============================================================================

# ── Secrets & environment ─────────────────────────────────────────────────────
# Keep .env.example (template); ignore real values
.env
.env.local
.env.*.local

# ── Maven build output ────────────────────────────────────────────────────────
**/target/

# Maven wrapper JAR (downloaded on first use; not needed in VCS)
.mvn/wrapper/maven-wrapper.jar

# ── Compiled Java ─────────────────────────────────────────────────────────────
*.class
*.jar
*.war
*.ear
*.nar

# ── Spring Boot ───────────────────────────────────────────────────────────────
# Local override files (never commit — they shadow application.properties)
application-local.properties
application-local.yml
**/src/main/resources/application-local.*
**/src/main/resources/application-dev.*

# Spring Boot log files
spring.log
*.log
logs/

# ── Node / React (root-level catch-all; frontend-service has its own) ─────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js

# React production build (never commit compiled output)
**/frontend-service/build/

# ── Docker / Podman ───────────────────────────────────────────────────────────
# Local override compose files
docker-compose.override.yml
podman-compose.override.yml

# ── Pipeline reports ──────────────────────────────────────────────────────────
pipeline-reports/
**/dependency-check-report.*
**/semgrep-*.json
**/zap-report.*

# ── IntelliJ IDEA ─────────────────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
out/

# ── VS Code ───────────────────────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json   # keep recommended extensions list if present

# ── Eclipse / STS ─────────────────────────────────────────────────────────────
.classpath
.project
.settings/
.factorypath

# ── NetBeans ──────────────────────────────────────────────────────────────────
nbproject/
nbbuild/
dist/
nbdist/
.nb-gradle/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# ── Windows ───────────────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Linux ─────────────────────────────────────────────────────────────────────
*~

# ── Temporary files ───────────────────────────────────────────────────────────
*.tmp
*.temp
*.swp
*.swo
