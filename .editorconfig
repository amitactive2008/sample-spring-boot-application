root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 4

[*.{properties,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[mvnw]
indent_style = tab

[*.cmd]
end_of_line = crlf

