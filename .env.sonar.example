# Non-secret SonarQube Cloud configuration.
# Copy to .env.sonar.local (ignored by Git), replace the organization key,
# and create four monorepo projects using this prefix plus each service name.
SONAR_MODE=cloud
SONAR_HOST_URL=https://sonarcloud.io
SONAR_ORGANIZATION=amitactive2008
SONAR_PROJECT_KEY_PREFIX=amitactive2008_sample-spring-boot-application

# Set SONAR_REGION=us only when your organization uses the US SonarQube Cloud region.
# SONAR_REGION=us

# Never put SONAR_TOKEN in this template. Enter it interactively or use a CI secret.
